# copy to .env and fill - NEVER commit .env
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
PORT=3000
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
SESSION_SECRET=long-random-hex
# production (Render) - set these in dashboard, not .env
# NODE_ENV=production
# FRONTEND_URL=https://forgestudio-303.github.io/forge-control
# GOOGLE_CALLBACK_URL=https://<your-service>.onrender.com/api/auth/google/callback
# GITHUB_CALLBACK_URL=https://<your-service>.onrender.com/api/auth/github/callback
