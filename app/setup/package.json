{
  "name": "forge-setup",
  "version": "1.0.0",
  "description": "Forge Control setup wizard - our own installer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.forgestudio.forgesetup",
    "productName": "Forge Control Setup",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "styles.css", "wizard.js", "package.json"],
    "extraResources": [{ "from": "../dist/win-unpacked", "to": "payload" }],
    "win": { "target": ["portable"] }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
