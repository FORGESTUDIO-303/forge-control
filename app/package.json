{
  "name": "forge-control-app",
  "version": "1.2.0",
  "description": "Forge Control desktop app - total PC control, one interface",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.forgestudio.forgecontrol",
    "productName": "Forge Control",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": ["tools/openrgb_ctl.py"],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "run.bat",
      "package.json",
      "tools/openrgb_ctl.py"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        { "from": "tools/lhm/", "to": "lhm/", "filter": ["FanCtl.exe", "*.dll"] }
      ]
    },
    "mac": { "target": ["dmg", "zip"] },
    "linux": { "target": ["AppImage"], "category": "Utility", "desktopName": "Forge Control", "syncDesktopName": true },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forge Control"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "systeminformation": "^5.33.12"
  }
}
